{
  "name": "license-scanner",
  "version": "1.0.5",
  "description": "Scan driver's license barcodes and allows copying of parsed fields into authorization systems",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "dist": "electron-builder --win portable"
  },
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.trustbiztech.license-scanner",
    "productName": "License Scanner",
    "icon": "wolflicense.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "wolflicense.ico",
      "renderer/**/*",
      "node_modules/**/*",
      "!dist/**/*",
      "!src/**/*",
      "!build.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "aamva-parser": "^1.6.0"
  }
}
